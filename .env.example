# =====================================================================
#  FOOTPROWORLD – modèle de configuration. Copie ce fichier en « .env » et remplis tes valeurs.
#  Ne mets JAMAIS ton vrai fichier .env sur GitHub (il est ignoré par .gitignore).
# =====================================================================
APP_NAME=FootProWorld
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Conakry

DB_CONNECTION=sqlite
# Sur Laravel Cloud : base PostgreSQL ou MySQL attachée (les variables DB_* sont remplies automatiquement)
# DB_CONNECTION=pgsql
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

# Stockage permanent des vidéos/photos (bucket Laravel Cloud, S3, Cloudflare R2…).
# Laravel Cloud remplit les variables AWS_* quand le bucket est attaché. Vide = fichiers gardés sur le serveur.
MEDIA_DISK=
MEDIA_SIGNED_URLS=false
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_URL=
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=fabara224@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Site
TERRAIN_APP_NAME=FootProWorld
TERRAIN_ADMIN_PASSWORD=
TERRAIN_COMPTES=reels
TERRAIN_PAYS_DEFAUT=Guinée
TERRAIN_EMAIL=fabara224@gmail.com
TERRAIN_TELEPHONES="00224 625112022,00224 626432276"
TERRAIN_EDITOR=
TERRAIN_EDITOR_ADDRESS=
TERRAIN_PRIVACY_EMAIL=fabara224@gmail.com
TERRAIN_SAFETY_EMAIL=fabara224@gmail.com
TERRAIN_SAFETY_CONTACT_NAME=
TERRAIN_BADGE_FOLLOWERS=1000
TERRAIN_FREE_CLUB_ACCESS_UNTIL=
TERRAIN_BOUTIQUE_URL=https://www.fabara-boutique.com
TERRAIN_BOUTIQUE_NOM=Fabara

# ---- Paiements Mobile Money (CinetPay)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCIES=GNF,XOF

# ---- FootProWorld est 100 % football
TERRAIN_SPORTS=Football

# ---- Créer son compte avec Google, Facebook ou TikTok (chaque bouton apparaît quand ses deux clés sont remplies)
# Adresses de retour à déclarer : https://TON-SITE/connexion/google/retour, …/connexion/facebook/retour, …/connexion/tiktok/retour
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ---- Lives des membres depuis leur téléphone (Cloudflare Stream, WebRTC)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=

# ---- Scores en direct des championnats (API-Football)
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=2,39,140,135,78,61,3,12
API_FOOTBALL_COUNTRY=Guinea

# ---- Matchs en direct
# Directs YouTube et vidéos « Découvrir » (gratuit : console.cloud.google.com > YouTube Data API v3)
YOUTUBE_API_KEY=
# Diffusion depuis un téléphone ou une caméra (Mux, payant)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# API du diffuseur partenaire : le lien du flux de chaque match (voir README, « Brancher un diffuseur »)
LIVE_PARTNER_NAME=
LIVE_PARTNER_URL=
LIVE_PARTNER_KEY=
LIVE_PARTNER_HEADER=Authorization
LIVE_PARTNER_FIELD=url

# ---- Modération (détection de la nudité, Sightengine)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ---- SMS et WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---- Notifications sur le téléphone (créées par : php artisan terrain:cles-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:fabara224@gmail.com

# ---- Appels audio et vidéo (serveur TURN conseillé en 4G)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Sous-titres automatiques (facultatif)
# Coach IA (Claude) : clé à créer sur https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
AI_COACH_FREE_PER_DAY=3

OPENAI_API_KEY=

# ---- Supabase (facultatif : sinon les comptes sont gardés dans la base du site)
SUPABASE_URL=
SUPABASE_ANON_KEY=
