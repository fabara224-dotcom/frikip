# =====================================================================
#  FRIKIP – modèle de configuration. Copie ce fichier en « .env » et remplis tes valeurs.
#  Ne mets JAMAIS ton vrai fichier .env sur GitHub (il est ignoré par .gitignore).
# =====================================================================
APP_NAME=Frikip
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Conakry

DB_CONNECTION=sqlite
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=frikip@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Site
TERRAIN_APP_NAME=Frikip
TERRAIN_ADMIN_PASSWORD=
TERRAIN_COMPTES=reels
TERRAIN_PAYS_DEFAUT=Guinée
TERRAIN_EMAIL=frikip@gmail.com
TERRAIN_TELEPHONES="00224 625112022,00224 626432276"
TERRAIN_EDITOR=
TERRAIN_EDITOR_ADDRESS=
TERRAIN_PRIVACY_EMAIL=frikip@gmail.com
TERRAIN_SAFETY_EMAIL=frikip@gmail.com
TERRAIN_SAFETY_CONTACT_NAME=
TERRAIN_BADGE_FOLLOWERS=1000
TERRAIN_FREE_CLUB_ACCESS_UNTIL=
TERRAIN_BOUTIQUE_URL=https://www.fabara-boutique.com
TERRAIN_BOUTIQUE_NOM=Fabara

# ---- Paiements Mobile Money (CinetPay)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCIES=GNF,XOF

# ---- Scores en direct des championnats (API-Football)
API_FOOTBALL_KEY=
API_FOOTBALL_LEAGUES=2,39,140,135,78,61,3,12
API_FOOTBALL_COUNTRY=Guinea

# ---- Matchs en direct
# Recherche automatique des directs YouTube (gratuit)
YOUTUBE_API_KEY=
# Diffusion depuis un téléphone ou une caméra (Mux, payant)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
# API du diffuseur partenaire : le lien du flux de chaque match (voir README, « Brancher un diffuseur »)
LIVE_PARTNER_NAME=
LIVE_PARTNER_URL=
LIVE_PARTNER_KEY=
LIVE_PARTNER_HEADER=Authorization
LIVE_PARTNER_FIELD=url

# ---- Modération (détection de la nudité, Sightengine)
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=

# ---- SMS et WhatsApp (Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ---- Notifications sur le téléphone (créées par : php artisan terrain:cles-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:frikip@gmail.com

# ---- Appels audio et vidéo (serveur TURN conseillé en 4G)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Sous-titres automatiques (facultatif)
OPENAI_API_KEY=

# ---- Supabase (facultatif : sinon les comptes sont gardés dans la base du site)
SUPABASE_URL=
SUPABASE_ANON_KEY=
